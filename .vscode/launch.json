{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
  
    {
      "name": "Attach to Kubernetes Pod (Go)",
      "type": "cloudcode.kubernetes",
      "request": "attach",
      "language": "Go",
      "debugPort": 2345,
      "podSelector": {
        "app": "deployment-name"
      },
      "localRoot": "${workspaceFolder}",
      "remoteRoot": "Path to the Remote Directory Containing the Program"
    },
    {
      "type": "node",
      "request": "attach",
      "name": "Containers: Attach to Node",
      "remoteRoot": "/usr/src/app"
    },
    {
      "name": "Cloud Run: Run/Debug Locally",
      "type": "cloudcode.cloudrun",
      "request": "launch",
      "build": {
        "docker": {
          "path": "Dockerfile"
        }
      },
      "image": "${workspaceFolderBasename}",
      "service": {
        "name": "${workspaceFolderBasename}",
        "containerPort": 8080,
        "resources": {
          "limits": {
            "memory": "256Mi"
          }
        }
      },
      "target": {
        "minikube": {}
      },
      "watch": true
    },
    {
      "name": "Python Debugger: Current File",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal"
    },
    {
      "name": "Attach to Kubernetes Pod (Python)",
      "type": "cloudcode.kubernetes",
      "request": "attach",
      "language": "Python",
      "debugPort": 3000,
      "podSelector": {
        "app": "deployment-name"
      },
      "localRoot": "${workspaceFolder}",
      "remoteRoot": "Path to the Remote Directory Containing the Program"
    },
    {
      "name": "Deploy Cloud Function",
      "type": "cloudcode.cloudfunctions",
      "request": "launch",
      "functionName": "ethopipe",
      "gen": "GEN_2",
      "runtime": "python312",
      "entryPoint": "app",
      "testInput": "",
      "revision": "1",
      "region": "us-central1"
    }
  ]
}